{
  "name": "trip-agent-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "agent": "tsx --env-file-if-exists=.env src/agent.ts",
    "evals": "tsx --env-file-if-exists=.env evals/run_evals.ts",
    "trace": "tsx scripts/show-trace.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
